# Environment Configuration
PROJECT_NAME="Appointment & Booking API"
APP_ENV=development
DEBUG=True

# ==============================================================================
# Supabase PostgreSQL Database Connection
# ==============================================================================
# In your Supabase Dashboard: Go to Project Settings -> Database -> Connection string
# 
# Option 1 (Recommended - Connection Pooling via PgBouncer / Supavisor, port 6543):
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# Option 2 (Direct connection, port 5432):
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

DATABASE_URL=

# ==============================================================================
# Supabase API (Client SDK for Auth, Storage, Edge Functions, etc.)
# ==============================================================================
# In your Supabase Dashboard: Go to Project Settings -> API
# - Project URL:
SUPABASE_URL=https://your-project-ref.supabase.co
# - anon public key or service_role secret key:
SUPABASE_KEY=your-anon-or-service-role-key
